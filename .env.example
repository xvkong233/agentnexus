# ========= Agent 管理平台环境配置 =========
# 复制为 .env 后按需修改。最小改动：只需改三个 SECRET。

# ---- 服务端口 ----
FRONTEND_PORT=8080
BACKEND_PORT=8000

# ---- 数据库 ----
POSTGRES_DB=agent_platform
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_secret_change_me

# ---- 安全密钥（生产环境务必替换为随机值）----
# JWT 签名密钥
SECRET_KEY=please-change-to-a-long-random-string
# 平台 BigModel API Key / 渠道敏感信息加密密钥（32字节 base64 或任意长字符串，后端会自动派生）
MASTER_KEY=please-change-to-another-long-random-string

# ---- 初始管理员（首次启动自动创建）----
FIRST_ADMIN_USER=admin
FIRST_ADMIN_PASSWORD=admin123456

# ---- 智谱 Managed Agents 上游 ----
# true: 内置模拟上游（无需真实 API Key 即可完整演示全流程，含模拟计费）
# false: 对接真实上游，需在管理端「平台密钥」录入 BigModel API Key
BIGMODEL_MOCK=true
BIGMODEL_BASE_URL=https://agent-api.bigmodel.cn/api/agent/managed
BIGMODEL_CHANNEL_BASE_URL=https://agent-api.bigmodel.cn/api/agent/forward/v0
# 协议头（勿随意改动，参考官方文档协议版本说明）
ZAI_VERSION=2026-05-26
ZAI_BETA=managed-agents-2026-09-22

# ---- 后台任务 ----
# backend 服务为单实例时保持 true；多副本部署时仅保留一个实例开启
WORKER_ENABLED=true
METERING_INTERVAL_SECONDS=30
SYNC_INTERVAL_SECONDS=60
GUARD_INTERVAL_SECONDS=60
